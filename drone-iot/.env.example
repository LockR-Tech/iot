# Chép thành .env trên Pi rồi sửa; đặt quyền `chmod 600 .env`. Không commit file .env thật.

# Mã drone trên admin Lock.R (drone_units.code)
# Ghi "DRONE-S550-07" để kết nối ngay, hoặc để trống để Pi tự phát hiện qua MAC trên Admin Web
DRONE_ID=DRONE-S550-07

# Cổng MAVLink của autopilot — lấy bằng: ls -l /dev/serial/by-id/
MAVLINK_PORT=/dev/serial/by-id/usb-Holybro_Pixhawk6C_XXXXXXXX-if00
MAVLINK_BAUD=115200

# Broker MQTT (cùng broker với backend). Không dùng localhost.
MQTT_HOST=broker.hivemq.com
MQTT_PORT=8883
MQTT_TLS=true
# Broker riêng sau Nginx: MQTT_HOST=api.locker-drone.tech, MQTT_PORT=443,
# MQTT_TRANSPORT=websockets, MQTT_WS_PATH=/mqtt, kèm tài khoản thiết bị.
# MQTT_TRANSPORT=tcp
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Khoá ký bản tin của riêng drone này (BÍ MẬT) — do backend cấp, xem lockr_drone/signing.py
DEVICE_KEY=

# Cổng phát video camera trực tiếp (mặc định 8080)
CAMERA_STREAM_PORT=8080

# Tuỳ chọn (giá trị dưới đây là mặc định)
# MESSAGE_RATE_HZ=2
# PUBLISH_INTERVAL_S=1
# HEARTBEAT_TIMEOUT_S=5
# STALE_AFTER_S=5

# ─── Nhận diện ArUco → xin mở nắp trượt tủ (README § Nhận diện ArUco) ───
# Mã ArUco cần tìm KHÔNG đặt ở đây: backend gửi theo nhiệm vụ (ô đích). Các giá trị dưới là mặc định.
# ARUCO_DICTIONARY=DICT_4X4_50       # phải trùng từ điển của ô đích, sai thì Pi báo lỗi và không gửi
# ARUCO_MARKER_SIZE_M=0.08           # cạnh marker in trên ô (m), để ước lượng khoảng cách
# ARUCO_STABLE_FRAMES=5              # số frame liên tiếp phải thấy đúng mã
# ARUCO_STABLE_SECONDS=0.6           # và thấy liên tục ít nhất chừng này giây
# ARUCO_LOST_RESET_S=1.0             # mất dấu quá chừng này giây thì đếm lại
# DELIVERY_RESPONSE_TIMEOUT_S=15     # chờ backend trả lời trước khi gửi lại
# DELIVERY_MAX_REQUESTS=3            # gửi tối đa chừng này lần mỗi lần tiếp cận
# DELIVERY_LID_TIMEOUT_S=180         # chờ tủ báo nắp đã mở
# TARGET_POLL_S=10                   # chưa có nhiệm vụ: hỏi backend mỗi chừng này giây
