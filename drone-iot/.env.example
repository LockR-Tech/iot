# Chép thành .env trên Pi rồi sửa; đặt quyền `chmod 600 .env`. Không commit file .env thật.

# Mã drone trên admin Lock.R (drone_units.code) — nằm trong topic MQTT
DRONE_ID=DRONE-S550-01

# Cổng MAVLink của autopilot — lấy bằng: ls -l /dev/serial/by-id/
MAVLINK_PORT=/dev/serial/by-id/usb-Holybro_Pixhawk6C_XXXXXXXX-if00
MAVLINK_BAUD=115200

# Broker MQTT (cùng broker với backend). Không dùng localhost.
MQTT_HOST=broker.hivemq.com
MQTT_PORT=8883
MQTT_TLS=true
# Broker riêng sau Nginx: MQTT_HOST=api.locker-drone.tech, MQTT_PORT=443,
# MQTT_TRANSPORT=websockets, MQTT_WS_PATH=/mqtt, kèm tài khoản thiết bị.
# MQTT_TRANSPORT=tcp
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Khoá ký bản tin của riêng drone này (BÍ MẬT) — do backend cấp, xem lockr_drone/signing.py
DEVICE_KEY=

# Tuỳ chọn (giá trị dưới đây là mặc định)
# MESSAGE_RATE_HZ=2
# PUBLISH_INTERVAL_S=1
# HEARTBEAT_TIMEOUT_S=5
# STALE_AFTER_S=5
